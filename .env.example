# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and provide secure values for production deployment.
# NEVER commit the real .env file or private keys to source control!
# ==============================================================================

# Application Environment
NODE_ENV=production
HOST_PORT=8080
IMAGE_TAG=latest
IMAGE_NAME=conduit-api

# JWT Application Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret

# MongoDB Administrative Credentials (used only for DB management & root mongodump)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace_with_secure_admin_password

# MongoDB Least-Privilege Application User (scoped strictly to [readWrite] on 'conduit')
APP_MONGO_USER=conduit_user
APP_MONGO_PASSWORD=replace_with_secure_app_user_password
APP_MONGO_DB=conduit

# Application Database Connection URI
MONGODB_URI=mongodb://conduit_user:replace_with_secure_app_user_password@mongo:27017/conduit?authSource=conduit

# Age Encryption (Public key used for backup encryption, e.g. age1...)
# Generate keypair: age-keygen -o age.key && age-keygen -y age.key
AGE_RECIPIENT_KEY=age1your_public_recipient_key_here

# Cloudflare R2 / S3-compatible Object Storage Credentials for Off-site Backups
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=studynow-backups
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# Monitoring & Alerting Webhook (Slack or Discord Incoming Webhook URL)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
HEALTH_CHECK_URL=http://localhost:8080/health
